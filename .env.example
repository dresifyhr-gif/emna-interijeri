# Copy to .env.local for local testing; set the same variables in Vercel
# (Project → Settings → Environment Variables, Production + Preview) and redeploy.

# Public address of the site, no trailing slash. Used for canonical URLs, the sitemap,
# Open Graph and the links in the inquiry e-mails ("Otvori kuhinju u 3D", privacy policy).
NEXT_PUBLIC_SITE_URL=

# Inquiry e-mails via Resend (resend.com). Until all three are set no e-mail goes out: inquiries are
# only stored in the database (below). Without the database too, the forms honestly say that online
# sending isn't switched on yet (API answers 503 not_configured).
# API key from resend.com → API Keys (starts with re_).
RESEND_API_KEY=
# Inbox that receives inquiries; several addresses separated by commas.
LEAD_EMAIL_TO=
# Sender on a domain verified in Resend, e.g. "EMNA Interijeri <upiti@vasa-domena.hr>".
LEAD_EMAIL_FROM=

# Database (Neon Postgres) — stores every inquiry and runs the admin (/admin: inquiries and quotes).
# The Neon integration in Vercel sets these. Without it inquiries are only e-mailed and /admin does not work.
# Create the tables once per database: npm run db:migrate (uses the unpooled URL).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional: private Vercel Blob store for the 3D snapshot of studio inquiries and for quote files.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in: a random string of at least 32 characters (signs the session cookie).
ADMIN_SESSION_SECRET=
# First admin user: open /admin/postavljanje?kod=<this value> once (at least 16 characters).
# The page does nothing any more as soon as an admin user exists.
ADMIN_SETUP_TOKEN=

# Optional: set to 1 to show the dashed "upisati: …" markers for missing company facts
# in a production build (e.g. on a preview deployment for the owner's review).
NEXT_PUBLIC_SHOW_TODO=
